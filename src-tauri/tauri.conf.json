{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mast",
  "version": "0.1.35",
  "identifier": "sh.standardapplied.mast",
  "build": {
    "frontendDist": "../dist-tauri",
    "beforeDevCommand": "bun run build:tauri-web",
    "beforeBuildCommand": "bun run build:tauri-web"
  },
  "app": {
    "windows": [
      {
        "title": "Mast",
        "width": 1180,
        "height": 800,
        "minWidth": 480,
        "minHeight": 600,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; img-src 'self' data: blob:; object-src blob:; connect-src 'self' data: ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5MjA5NjhDQUQyMDM4QTUKUldTbE9DQ3RqSllncWVFN3MxejFRR1hSY2ppOEpBLzFKMFkxalc1cFRGbGVrUjlZQTUzcXYrV0YK",
      "endpoints": [
        "https://github.com/standardapplied/mast/releases/latest/download/latest.json"
      ]
    }
  }
}
